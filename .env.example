# Supabase project (everything lives in schema atlas)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# admin connection: migrations + seed only, never used by the app
DATABASE_ADMIN_URL=
# app connection: least-privilege role atlas_app through the transaction pooler (port 6543)
ATLAS_APP_PASSWORD=
DATABASE_URL=postgres://atlas_app.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require
# workers (bearer secret for /api/worker; also stored in Vault for pg_cron)
ATLAS_WORKER_SECRET=
# public URL used for worker fan-out in production
ATLAS_PUBLIC_URL=
# demo accounts
ATLAS_DEMO_PASSWORD=
# Gemini via its OpenAI-compatible endpoint
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash
